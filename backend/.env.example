# Copy this file to backend/.env and fill in your own values.
# Never commit backend/.env to GitHub.

PORT=5000

# true  = demo mode (no database, users are NOT saved)
# false = MongoDB mode (users are saved to MongoDB Atlas)
DEMO_MODE=false

# Your MongoDB Atlas connection string. Replace <username>, <password> and
# <dbname> (for example mern_signup). If your password has special characters
# such as @ : / ? # % use URL encoding, e.g. @ becomes %40.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/<dbname>?retryWrites=true&w=majority
